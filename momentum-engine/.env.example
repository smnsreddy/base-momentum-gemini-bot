# Base Momentum & Gemini AI Engine Environment Configuration

# Server Port (Default: 3001)
PORT=3001

# Google Gemini API Key (Gemini 3.5 Flash-Lite Quantitative Engine)
GEMINI_API_KEY=your_gemini_api_key_here

# Base L2 RPC URL
BASE_RPC_URL=https://mainnet.base.org

# Optional: Real Trading Signer Private Key (Only needed for Real On-Chain Mode)
# WALLET_PRIVATE_KEY=your_private_key_here

# Optional: GitHub Auto-Push Token (For publishing live trade results back to GitHub)
# GITHUB_TOKEN=ghp_your_token_here
# GITHUB_REPO=smnsreddy/base-momentum-gemini-bot
